{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "users": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "articles": {
        "ClusterId": "articles-cluster",
        "Match": {
          "Path": "/api/articles/{**catch-all}"
        }
      },
      "tags": {
        "ClusterId": "articles-cluster",
        "Match": {
          "Path": "/api/tags/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "users-cluster": {
        "Destinations": {
          "userService": {
            "Address": "http://svc-users:8080/"
          }
        }
      },
      "articles-cluster": {
        "Destinations": {
          "articleService": {
            "Address": "http://svc-articles:8080/"
          }
        }
      }
    }
  }
}